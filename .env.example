# Local (default): Ollama's OpenAI-compatible API
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# The judge can be a different, stronger model
JUDGE_MODEL=qwen2.5:7b
# Which drafter version is "production" (the CI gate tests this one)
PROMPT_VERSION=v2
# Your provider's price in USD per million tokens (0 for a local model)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
EVAL_CONCURRENCY=4
